# Never commit your local environment file.
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Run artefacts
*.log
scorecard-*.json
results*.json
conformance-*.json
# Archived evidence cited by the documentation is versioned.
!results/*.json

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Large reproducible experiment outputs; compressed evidence is versioned.
results/development.json
results/holdout.json
results/tuning.json
results/benchmark.json
results/live-seed-simulation.json

# Local dashboard test dependencies and browser caches.
.browser-tools/
.browser-tmp/
.browsers/
node_modules/
